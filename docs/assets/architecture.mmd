flowchart LR
    sender["Sender<br/>Keep source locally<br/>Encode preview + media frames"]
    mesh["Software mesh<br/>Route · prioritize · retry"]
    recipient["Recipient<br/>Reassemble + verify<br/>Reveal detail + send receipt"]
    sender -->|"Preview / detail"| mesh
    mesh -->|"Media frames"| recipient
    recipient -->|"Crop requests + verified receipts"| mesh
    mesh -->|"Return control messages"| sender

    classDef endpoint fill:#f6f8f6,stroke:#dce4df,color:#182824;
    classDef relay fill:#ffffff,stroke:#32755c,color:#182824;
    class sender,recipient endpoint;
    class mesh relay;

%% CURRENT DEMO: Both views share one browser, local API and temporary database.
%% PRIVACY TODAY: Local processing; plaintext storage and packets. CRC/SHA-256
%% detect corruption. No end-to-end encryption or cryptographic peer identity.
%% PROPOSED: Verified identities; encrypted media, control messages and receipts;
%% encrypted endpoint storage; ciphertext-only relays. Radio metadata stays visible.
%% FAILURE MODES: Retry loss; alternate route where available; no route waits
%% without ETA; retry exhaustion fails; lost receipt leaves sender unconfirmed;
%% reload loses browser receive progress. Firmware integration is unfinished.
